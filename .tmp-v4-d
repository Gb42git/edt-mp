";
const b64d=s=>Uint8Array.from(atob(s),c=>c.charCodeAt(0));
// Suite 84 : clé de mémorisation PAR GATE (v2/v3/v4 selon le chemin de la page) —
// les 3 gates partagent la même origine (donc le même localStorage) mais des mots
// de passe potentiels différents ; une clé unique voyait mph et mphgb s'écraser.
const GATE_SEG=(location.pathname.match(/\/(v[234])\//)||[])[1]||'x';
const PWKEY='edt-mp-pw-'+GATE_SEG;
// Migration douce : un mot de passe sauvegardé par l'ANCIENNE clé unique est repris
// (une fois) par cette gate — la mémorisation existante survit au changement de clé.
try{if(!localStorage.getItem(PWKEY)&&localStorage.getItem('edt-mp-pw'))localStorage.setItem(PWKEY,localStorage.getItem('edt-mp-pw'));}catch(x){}
async function unlock(auto){
  const btn=document.getElementById('go'),err=document.getElementById('err');
  btn.disabled=true;btn.textContent='Vérification…';err.style.display='none';
  try{
    const pw=document.getElementById('pw').value;
    const km=await crypto.subtle.importKey('raw',new TextEncoder().encode(pw),'PBKDF2',false,['deriveKey']);
    const key=await crypto.subtle.deriveKey({name:'PBKDF2',salt:b64d(SALT),iterations:ITERS,hash:'SHA-256'},km,{name:'AES-GCM',length:256},false,['decrypt']);
    const raw=b64d(DATA);
    const pt=await crypto.subtle.decrypt({name:'AES-GCM',iv:b64d(IV)},key,raw);
    // Suite 84 (fix du bug « mot de passe redemandé sans arrêt ») : le localStorage
    // n'est écrit QU'ICI — après un décryptage RÉUSSI d'une saisie MANUELLE. L'ancien
    // code écrivait/effaçait AVANT le décryptage : l'auto-déverrouillage repartait
    // avec la case « Mémoriser » décochée et détruisait le mot de passe qu'il venait
    // d'utiliser → la mémorisation ne survivait qu'à un seul rechargement.
    // Un échec de décryptage n'efface JAMAIS le mot de passe sauvegardé.
    if(!auto){try{if(document.getElementById('mem').checked)localStorage.setItem(PWKEY,pw);else localStorage.removeItem(PWKEY);}catch(x){}}
    // Injection dans le MÊME document (l'URL https://... reste, le service worker
    // reste actif). NE PAS faire location.replace(URL.createObjectURL(blob)) :
    // URL blob: à usage unique, hors du scope du SW, affichée par Chrome en PWA.
    document.open();document.write(new TextDecoder().decode(pt));document.close();
  }catch(e){err.style.display='block';btn.disabled=false;btn.textContent='Déverrouiller';}
}
document.getElementById('pw').addEventListener('keydown',e=>{if(e.key==='Enter')unlock(false);});
// Mot de passe mémorisé : déverrouillage automatique (silencieux) au chargement —
// il ne TOUCHE plus au localStorage (bug suite 84 corrigé) et l'échec éventuel
// (mot de passe changé par une nouvelle publication) l'affiche en clair : la
// saisie manuelle décidera de le remplacer ou non.
try{const saved=localStorage.getItem(PWKEY);if(saved){document.getElementById('pw').value=saved;document.getElementById('mem').checked=true;unlock(true).catch(()=>{});}}catch(x){}
</script>
<script>if(navigator.serviceWorker)navigator.serviceWorker.register("sw.js")</script></body>
</html>